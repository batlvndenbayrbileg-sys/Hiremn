# API Security
API_SECRET_KEY=your_secure_api_key_here

# Google Gemini API (chat + analyze LLM)
GEMINI_API_KEY=your_gemini_key_here
# Optional: override the model (default: gemini-flash-latest, auto-falls back if gated)
# GEMINI_MODEL=gemini-3.5-flash

# Database (if needed)
DATABASE_URL=

# Environment
NODE_ENV=production
VERCEL_ENV=production

# Security
CSRF_TOKEN_SECRET=your_csrf_secret_here
SESSION_SECRET=your_session_secret_here

# CORS
ALLOWED_ORIGINS=https://hire.mn,https://www.hire.mn

# Rate Limiting
RATE_LIMIT_TOKENS_PER_MINUTE=100
